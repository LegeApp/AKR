akr 0.1
project fixtures

record fx.policy.anchors/1 : policy {
    title "Anchors, revision 1"
    state superseded
    scope [ all ]
    rule """
        The first rule.
        """
    claim gone {
        text """
            A claim that revision 2 retires.
            """
    }
}

record fx.policy.anchors/2 : policy {
    title "Anchors, revision 2"
    state active
    scope [ all ]
    rule """
        The second rule.
        """
    claim kept {
        text """
            A claim that survives.
            """
    }
    retired_claims [ gone ]
    supersedes [ @fx.policy.anchors/1 ]
}

record fx.assessment.cites-retired/1 : assessment {
    title "Cites a retired claim through a floating reference"
    state verified
    statement """
        The reference below floats to revision 2, which retired the anchor.
        """
    supported_by [ @fx.policy.anchors#gone ]
}
