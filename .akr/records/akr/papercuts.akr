record akr.papercut.revising-a-sealed-record-through-the-supported/1 : papercut {
    title "Revising a sealed record through the supported knowledge.revise path…"
    state verified
    statement """
        Revising a sealed record through the supported knowledge.revise path changes its old revision to superseded and causes knowledge.validate to report AKR-R051 until rebuild, while ops documentation says lifecycle writes should produce AKR-R052. This makes an authorized lifecycle transition look like sealed-content tampering; distinguish it or document the exact rebuild boundary.
        """
    observed_at git:911c29573461ba912cc141f49f4d8c05c61ec5e1
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.root-cause-of-the-discoverability-miss-the-cli/1 : papercut {
    title "Root cause of the discoverability miss: the CLI's AKR-C011 error…"
    state superseded
    statement """
        Root cause of the discoverability miss: the CLI's AKR-C011 error carries help 'run akr init to create one', but the MCP surface drops it — crates/akr-mcp/src/errors.rs builds its diagnostic object with only code and message (no help field), so an agent hitting C011 over MCP sees 'no .akr directory found' with no remedy. Fix: propagate EnvError.help into the MCP diagnostics payload.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.root-cause-of-the-discoverability-miss-the-cli/2 : papercut {
    title "Root cause of the discoverability miss: the CLI's AKR-C011 error…"
    state withdrawn
    statement """
        Root cause of the discoverability miss: the CLI's AKR-C011 error carries help 'run akr init to create one', but the MCP surface drops it — crates/akr-mcp/src/errors.rs builds its diagnostic object with only code and message (no help field), so an agent hitting C011 over MCP sees 'no .akr directory found' with no remedy. Fix: propagate EnvError.help into the MCP diagnostics payload.

        RESOLVED: commit 8866c42 (cli/mcp: carry the error help line into environment-error JSON). EnvError.help now reaches the MCP diagnostics payload, so an agent hitting AKR-C011 over MCP is told to run akr init.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    supersedes [ @akr.papercut.root-cause-of-the-discoverability-miss-the-cli/1 ]
}

record akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/1 : papercut {
    title "The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory…"
    state superseded
    statement """
        The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory found' at the repo root because AKR had no root ledger of its own — the only papercut records lived inside example fixtures the MCP server could not reach. Finding recorded papercuts meant grepping the filesystem. Fixed by running akr init at the repo root (this ledger).
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/2 : papercut {
    title "The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory…"
    state withdrawn
    statement """
        The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory found' at the repo root because AKR had no root ledger of its own — the only papercut records lived inside example fixtures the MCP server could not reach. Finding recorded papercuts meant grepping the filesystem. Fixed by running akr init at the repo root (this ledger).

        RESOLVED: commit 047a684 (chore: dogfood AKR with a root ledger). The repository root now carries its own ledger, so knowledge.* resolves there and papercuts no longer have to be found by grep.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    supersedes [ @akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/1 ]
}
