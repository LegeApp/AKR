akr 0.1
project akr

record akr.papercut.calling-the-knowledge-papercut-mcp-tool/1 : papercut {
    title "Calling the knowledge.papercut MCP tool returned 'unsupported call',…"
    state verified
    statement """
        Calling the knowledge.papercut MCP tool returned 'unsupported call', even though knowledge.search and knowledge.context route fine and crates/akr-mcp/src/tools.rs wires knowledge.papercut. The installed MCP server binary predates the D-027 papercut work; it needs a rebuild/reinstall from this branch to expose the tool.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.cargo-fmt-check-fails-on-the-committed-tree/1 : papercut {
    title "cargo fmt --check fails on the committed tree: several files from the…"
    state verified
    statement """
        cargo fmt --check fails on the committed tree: several files from the last two commits (render/*, resolve/mod.rs, validate/rules.rs, akr-mcp record.rs/schema.rs/tools.rs, args.rs, write.rs) have formatting drift. A contributor running the documented 'cargo fmt' gets a large diff unrelated to their change, and a CI fmt gate would already be red.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.root-cause-of-the-discoverability-miss-the-cli/1 : papercut {
    title "Root cause of the discoverability miss: the CLI's AKR-C011 error…"
    state verified
    statement """
        Root cause of the discoverability miss: the CLI's AKR-C011 error carries help 'run akr init to create one', but the MCP surface drops it — crates/akr-mcp/src/errors.rs builds its diagnostic object with only code and message (no help field), so an agent hitting C011 over MCP sees 'no .akr directory found' with no remedy. Fix: propagate EnvError.help into the MCP diagnostics payload.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/1 : papercut {
    title "The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory…"
    state verified
    statement """
        The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory found' at the repo root because AKR had no root ledger of its own — the only papercut records lived inside example fixtures the MCP server could not reach. Finding recorded papercuts meant grepping the filesystem. Fixed by running akr init at the repo root (this ledger).
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}
