record akr.papercut.knowledge-context-rejects-completed-work-goals/1 : papercut {
    title "knowledge.context rejects completed work goals with AKR-X002 even when…"
    state verified
    statement """
        knowledge.context rejects completed work goals with AKR-X002 even when the repository protocol says to call context with the exact planning key; corrective follow-up needs a new work record before the prior bundle can be inspected.
        """
    observed_at git:911c29573461ba912cc141f49f4d8c05c61ec5e1
    about "akr"
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.knowledge-search-detects-a-stale-index-but/1 : papercut {
    title "knowledge.search detects a stale index but continues serving it, so…"
    state verified
    statement """
        knowledge.search detects a stale index but continues serving it, so agents repeatedly receive known-old planning results until a human runs `akr build`. Search should safely refresh or fall back to current source data before returning results.
        """
    observed_at git:f001cde97b054e587f14ab849fe754ed1e14ebf0
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.revising-a-sealed-record-through-the-supported/1 : papercut {
    title "Revising a sealed record through the supported knowledge.revise path…"
    state verified
    statement """
        Revising a sealed record through the supported knowledge.revise path changes its old revision to superseded and causes knowledge.validate to report AKR-R051 until rebuild, while ops documentation says lifecycle writes should produce AKR-R052. This makes an authorized lifecycle transition look like sealed-content tampering; distinguish it or document the exact rebuild boundary.
        """
    observed_at git:911c29573461ba912cc141f49f4d8c05c61ec5e1
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.root-cause-of-the-discoverability-miss-the-cli/1 : papercut {
    title "Root cause of the discoverability miss: the CLI's AKR-C011 error…"
    state superseded
    statement """
        Root cause of the discoverability miss: the CLI's AKR-C011 error carries help 'run akr init to create one', but the MCP surface drops it — crates/akr-mcp/src/errors.rs builds its diagnostic object with only code and message (no help field), so an agent hitting C011 over MCP sees 'no .akr directory found' with no remedy. Fix: propagate EnvError.help into the MCP diagnostics payload.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.root-cause-of-the-discoverability-miss-the-cli/2 : papercut {
    title "Root cause of the discoverability miss: the CLI's AKR-C011 error…"
    state withdrawn
    statement """
        Root cause of the discoverability miss: the CLI's AKR-C011 error carries help 'run akr init to create one', but the MCP surface drops it — crates/akr-mcp/src/errors.rs builds its diagnostic object with only code and message (no help field), so an agent hitting C011 over MCP sees 'no .akr directory found' with no remedy. Fix: propagate EnvError.help into the MCP diagnostics payload.

        RESOLVED: commit 8866c42 (cli/mcp: carry the error help line into environment-error JSON). EnvError.help now reaches the MCP diagnostics payload, so an agent hitting AKR-C011 over MCP is told to run akr init.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    supersedes [ @akr.papercut.root-cause-of-the-discoverability-miss-the-cli/1 ]
}

record akr.papercut.running-rustfmt-directly-on-akr-s-rust-2024/1 : papercut {
    title "Running rustfmt directly on AKR's Rust 2024 files defaulted to an older…"
    state verified
    statement """
        Running rustfmt directly on AKR's Rust 2024 files defaulted to an older edition and rejected existing let-chains; the non-obvious required invocation is rustfmt --edition 2024.
        """
    observed_at git:2dd07efa746065e627b1445587e3bb0ca0af553b
    about "rustfmt"
    author "codex"
    created_at 2026-08-12
}

record akr.papercut.strict-clippy-for-the-new-gui-crate-promoted/1 : papercut {
    title "Strict clippy for the new GUI crate promoted more than 200 existing…"
    state verified
    statement """
        Strict clippy for the new GUI crate promoted more than 200 existing missing-docs warnings from the in-progress ingest APIs and obscured the one GUI lint. A target-scoped lint profile or temporary ingest-specific allowance would keep unrelated dependency warnings from swamping focused checks.
        """
    observed_at git:de899cd260ab7b8f303a53ed5051118f211c2eb9
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/1 : papercut {
    title "The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory…"
    state superseded
    statement """
        The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory found' at the repo root because AKR had no root ledger of its own — the only papercut records lived inside example fixtures the MCP server could not reach. Finding recorded papercuts meant grepping the filesystem. Fixed by running akr init at the repo root (this ledger).
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    author "fugu"
    created_at 2026-08-05
}

record akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/2 : papercut {
    title "The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory…"
    state withdrawn
    statement """
        The akr MCP knowledge.* tools failed with AKR-C011 'no .akr directory found' at the repo root because AKR had no root ledger of its own — the only papercut records lived inside example fixtures the MCP server could not reach. Finding recorded papercuts meant grepping the filesystem. Fixed by running akr init at the repo root (this ledger).

        RESOLVED: commit 047a684 (chore: dogfood AKR with a root ledger). The repository root now carries its own ledger, so knowledge.* resolves there and papercuts no longer have to be found by grep.
        """
    observed_at git:30579aeb4960ca7b4de2659953ce0694541bfa96
    supersedes [ @akr.papercut.the-akr-mcp-knowledge-tools-failed-with-akr/1 ]
}

record akr.papercut.the-akr-mcp-transport-closed-on-explain-and/1 : papercut {
    title "The AKR MCP transport closed on explain and propose calls, forcing a…"
    state verified
    statement """
        The AKR MCP transport closed on explain and propose calls, forcing a CLI fallback. The CLI described --from as a record body but rejected plain prose because a required slot declaration was still needed; the help should name the accepted slot-list shape explicitly.
        """
    observed_at git:05fea30a52f59775917cf5a1d1ac1241c0392b44
    about "akr"
    author "codex"
    created_at 2026-08-11
}

record akr.papercut.the-cli-help-advertises-edit-for-propose-and/1 : papercut {
    title "The CLI help advertises --edit for propose and revise, but this build…"
    state verified
    statement """
        The CLI help advertises --edit for propose and revise, but this build rejects it as unavailable; the documented path caused an avoidable failed write before falling back to --from.
        """
    observed_at git:de899cd260ab7b8f303a53ed5051118f211c2eb9
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.the-repository-instructions-direct-agents-to/1 : papercut {
    title "The repository instructions direct agents to use…"
    state verified
    statement """
        The repository instructions direct agents to use `knowledge.start`/`knowledge.context`, but the installed `akr.exe` has no `knowledge` CLI command; the MCP ledger tools were required instead. The documented CLI and installed binary are out of sync.
        """
    observed_at git:de899cd260ab7b8f303a53ed5051118f211c2eb9
    about "akr"
    author "Codex"
    created_at 2026-08-09
}

record akr.papercut.while-beginning-a-change-transaction-the/1 : papercut {
    title "While beginning a change transaction, the natural kind 'feature' was…"
    state verified
    statement """
        While beginning a change transaction, the natural kind 'feature' was rejected because the accepted spelling is the undocumented Conventional Commit abbreviation 'feat'; the error recovers well, but help or aliasing would avoid the retry.
        """
    observed_at git:05fea30a52f59775917cf5a1d1ac1241c0392b44
    author "codex"
    created_at 2026-08-11
}

record akr.papercut.while-checking-akr-mcp-without-default-features/1 : papercut {
    title "While checking akr-mcp without default features, the differential…"
    state verified
    statement """
        While checking akr-mcp without default features, the differential harness first used a stale default-feature target/debug/akr unless that CLI binary was rebuilt explicitly; after rebuilding correctly, two knowledge.start fallback tests still fail because the non-FTS validated-head path omits coverage and workspace_fallback metadata. The budget/pagination tests themselves pass in that configuration.
        """
    observed_at git:2dd07efa746065e627b1445587e3bb0ca0af553b
    about "akr"
    author "codex"
    created_at 2026-08-12
}

