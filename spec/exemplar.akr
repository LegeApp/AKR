# spec/exemplar.akr — FROZEN syntax specimen for AKR 0.1.
#
# Every construct in the language appears here at least once, canonically
# formatted per D-012. This file is the only source of quotable syntax forms:
# if a form does not appear here, do not write it in a specification document,
# an example, or a fixture. The records describe a toy project and are not
# expected to satisfy every validation rule.

akr 0.1
project exemplar

record demo.assessment.coverage-gaps/1 : assessment {
    title "Projection coverage is thinnest around day boundaries"
    state verified
    statement """
        Across the projection suite, the least-covered code paths cluster at the
        transition between one in-game day and the next.
        """
    confidence medium
    as_of git:b2e58f1406c7a9d3e41b60258fa3d7c6195e0b48
    claim projection-coverage {
        text """
            Day-boundary projection paths have materially lower test coverage
            than steady-state paths.
            """
    }
    author "dkoepke"
    created_at 2026-02-11
}

record demo.milestone.playable-day/1 : milestone {
    title "M1 — playable day"
    state active
    intent """
        A player can start, play and finish one in-game day without a crash, a
        soft-lock, or a placeholder asset.
        """
    target 2026-09-30
    acceptance {
        check full-day-demo {
            statement """
                A recorded session shows one complete in-game day, start to finish.
                """
            method observation
            verified_by [ @pkg.evidence.day-loop-demo/1 ]
        }
        check no-placeholder-assets {
            statement """
                The asset audit reports zero placeholder assets on the day-loop path.
                """
            method command
            command "cargo run -p tools -- audit-assets --path content/day-loop"
        }
    }
    author "dkoepke"
}

record demo.obs.frame-budget/1 : observation {
    title "Day-loop frames land inside the budget with headroom"
    state verified
    scope [ path "engine/render/**" ]
    statement """
        Over a 20-minute captured session the 99th-percentile frame time was
        11.4 ms against a 16 ms budget.
        """
    observed_at git:e806b3f54a2d7091c5e13b8a26f490dc7b135e64
    method instrumented
    watches [ "engine/render/**", "engine/sim/step.rs" ]
    review_after 2026-12-01
    contradicts [ @demo.assessment.coverage-gaps/1 ]  # measured, not audited
    acknowledged true
    author "dkoepke"
    created_at 2026-03-02
    source {
        kind external
        url "https://ci.example.invalid/runs/8814"
    }
}

record demo.policy.tandem-work/1 : policy {
    title "Engine and simulator advance in tandem"
    state superseded
    scope [ all ]
    topic tandem-work
    rule """
        No engine change lands without the matching simulator change in the same
        commit.
        """
}

record demo.policy.tandem-work/2 : policy {
    title "Engine and simulator advance in tandem"
    state active
    scope [ ref @demo.milestone.playable-day, path "engine/**" ]
    topic tandem-work
    rule """
        No engine change lands without the matching simulator change in the same
        commit, except on the tracks listed under exceptions, where the
        simulator may lag by at most one milestone.
        """
    rationale """
        Divergence between the two has cost more time than the coupling does.
        """
    exceptions [ @demo.track.lighting ]
    claim lag-bound {
        text """
            Permitted simulator lag is at most one milestone, never two.
            """
    }
    claim same-commit {
        text """
            Matching changes ship in one commit, not in a follow-up commit.
            """
        supported_by [ @demo.assessment.coverage-gaps/1#projection-coverage ]
    }
    retired_claims [ no-exceptions ]
    depends_on [ @demo.term.playable-day/1#day-boundary ]
    supersedes [ @demo.policy.tandem-work/1 ]
    supported_by [ @demo.assessment.coverage-gaps#projection-coverage ]
    author "dkoepke"
    created_at 2026-03-04
    source {
        kind legacy
        path "docs/legacy/WORKING-AGREEMENTS.md"
        excerpt """
            Engine and sim should stay in step. (No exceptions were listed.)
            """
    }
}

record demo.term.playable-day/1 : term {
    title "Playable day"
    state active
    scope [ all ]
    definition """
        One in-game day, from the morning wake state to the following morning
        wake state, played end to end by one player.
        """
    aliases [ "playable day", "day-loop build" ]
    claim day-boundary {
        text """
            A day boundary is the morning wake state, not midnight.
            """
    }
    author "dkoepke"
    created_at 2026-01-14
}

record demo.track.lighting/1 : track {
    title "Lighting"
    state active
    intent """
        Standing lighting work that no milestone contains.
        """
    cadence "one pass per milestone"
}

record demo.work.day-loop-plan/1 : work {
    title "Day-loop plan"
    state superseded
    intent """
        First plan for the day loop: sequence the sim, then the renderer.
        """
    plan_of_record [ @demo.milestone.playable-day ]
}

record demo.work.day-loop-plan/2 : work {
    title "Day-loop plan"
    state active
    intent """
        Revised plan for the day loop: land the renderer boundary first, then
        the sim step, then the audit.
        """
    target 2026-08-30
    # Every unfinished child of revision 1 must be dispositioned here (D-017).
    disposition @demo.work.lighting-pass {
        outcome carried_forward
        into @demo.track.lighting
        note """
            Lighting is standing work; it does not belong to this milestone.
            """
    }
    implements [ @demo.policy.tandem-work ]
    plan_of_record [ @demo.milestone.playable-day ]
    supersedes [ @demo.work.day-loop-plan/1 ]
    author "dkoepke"
    created_at 2026-06-18
}

record demo.work.lighting-pass/1 : work {
    title "Lighting pass for the day loop"
    state ready
    intent """
        One lighting pass over the day-loop scenes.
        """
    part_of [ @demo.work.day-loop-plan ]
}

record pkg.evidence.day-loop-demo/1 : evidence {
    title "Recorded full-day session"
    state verified
    result pass
    method observation
    observed_at git:e806b3f54a2d7091c5e13b8a26f490dc7b135e64
    artifact "artifacts/2026-07-11-day-loop.mp4"
    summary """
        One complete in-game day, 41 minutes, no crash and no soft-lock.
        """
    author "dkoepke"
    created_at 2026-07-11
}
