akr 0.1
project save-your-skin

record lege.decision.renderer-boundary/1 : decision {
    title "The viewer calls the simulator directly"
    state superseded
    scope [ path "lege/**" ]
    topic renderer-boundary
    decision """
        The viewer calls simulator entry points directly at each tick boundary and
        reads state through them.
        """
    context """
        Chosen for the walking skeleton, when there was no frame snapshot to read and
        no second consumer of simulator state.
        """
    claim direct-calls {
        text """
            The viewer calls simulator entry points directly; there is no intermediate
            representation of frame state.
            """
    }
    author "dkoepke"
    created_at 2026-02-10
}

record lege.decision.renderer-boundary/2 : decision {
    title "The viewer consumes a frame snapshot"
    state active
    scope [ path "lege/**" ]
    topic renderer-boundary
    decision """
        The viewer reads an immutable frame snapshot produced by the simulator at each
        tick boundary. It does not call into the simulator, and no engine type appears
        in a viewer signature.
        """
    context """
        Revision 1 put engine types in viewer signatures and made the viewer
        untestable in isolation. The text-layout question turned on the same boundary,
        so both were settled together.
        """
    consequences """
        One extra allocation and copy per frame, measured at 0.4 ms against the 16 ms
        budget. Accepted. The snapshot type is now a third thing to keep in step when
        simulator state changes, which the tandem-work policy already covers.
        """
    claim no-engine-types {
        text """
            No engine type appears in any public viewer signature.
            """
        supported_by [ @lege.evidence.boundary-lint-pass ]
    }
    retired_claims [ direct-calls ]
    derived_from [ @lege.obs.viewer-imports-engine/1 ]
    implements [ @lege.req.no-engine-types-in-viewer ]
    resolves [ @lege.question.text-rendering-owner ]
    supersedes [ @lege.decision.renderer-boundary/1 ]
    author "dkoepke"
    created_at 2026-05-22
}
