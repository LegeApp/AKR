akr 0.1
project save-your-skin

record lege.obs.frame-budget-headroom/1 : observation {
    title "Day-loop frames land inside the budget with headroom"
    state verified
    scope [ path "lege/src/render/**" ]
    statement """
        Over a 20-minute captured session of the day loop, the 99th-percentile frame
        time was 11.4 ms against the 16 ms budget. The worst single frame, on the barn
        interior transition, was 14.8 ms.
        """
    observed_at git:e806b3f54a2d7091c5e13b8a26f490dc7b135e64
    method instrumented
    watches [ "lege/src/render/**" ]
    review_after 2026-12-01
    author "dkoepke"
    created_at 2026-07-30
}

record lege.obs.viewer-imports-engine/1 : observation {
    title "The viewer imports engine types"
    state disproven
    scope [ path "lege/**" ]
    statement """
        Eleven public viewer functions take or return simulator types, and the viewer
        crate does not build without the simulator crate.
        """
    observed_at git:b2e58f1406c7a9d3e41b60258fa3d7c6195e0b48
    method command
    watches [ "lege/**" ]
    author "dkoepke"
    created_at 2026-04-18
}
