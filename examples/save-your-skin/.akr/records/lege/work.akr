akr 0.1
project save-your-skin

record lege.work.extract-render-graph/1 : work {
    title "Extract the render graph behind the boundary"
    state active
    intent """
        Move the render graph behind the frame-snapshot boundary so the viewer builds
        and tests without the simulator crate, and the snapshot type is the only
        shared surface.
        """
    depends_on [ @lege.decision.renderer-boundary ]
    implements [ @lege.req.no-engine-types-in-viewer ]
    part_of [ @sys.milestone.m3-playable-day ]
    author "dkoepke"
    created_at 2026-06-20
}
