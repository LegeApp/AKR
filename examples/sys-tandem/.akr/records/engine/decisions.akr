akr 0.1
project sys-tandem

record engine.decision.placeholder-tts-offline/1 : decision {
    title "Placeholder voices are TTS baked offline into voice assets"
    state active
    scope [ path "SYSEngine/crates/sys_sound/**" ]
    topic placeholder-voices
    decision """
        Placeholder voices are generated offline by a build or bake tool into ordinary
        voice-asset files, one per rendered line or per delivery template. The runtime
        decodes them through the existing symphonia path.
        """
    context """
        The voice-acting question looked like a blocker for M3. The architecture
        already contained the answer: only Clear and Partial speech needs a voice at
        all, Murmur is procedural babble by design, and Inaudible is nothing. Ambience
        derives from occupancy and activity records and needs no voices.
        """
    consequences """
        Every testing objective — earshot parity, masking at the source, clarity
        determinism — is met with zero art budget and no runtime dependency. Swapping
        real recordings in later touches no code.
        """
    implements [ @tandem.constraint.no-runtime-tts ]
    created_at 2026-08-03
    source {
        kind legacy
        path "SYSEngine/docs/plans/sound.md"
        excerpt """
            sound.md sections 4 and 5.
            """
    }
}
