project sys-tandem

record simulator.question.wild-threshold/1 : question {
    title "Should the wild threshold assertion be un-ignored?"
    state resolved
    question """
        M1's acceptance named two #[ignore]d assertions in squelch_audit.rs. The wild
        threshold one only passes if ordinary day generation schedules a nearby
        qualifying council. Should generation be changed to satisfy it, or should the
        assertion stay ignored?
        """
    resolution """
        It stays ignored, by explicit designer ruling on 2026-08-03: ordinary
        generation need not schedule a nearby qualifying council. M1's acceptance was
        revised to name the calm assertion only.
        """
    created_at 2026-08-03
}
